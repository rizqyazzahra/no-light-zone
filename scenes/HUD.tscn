"transitions": PackedFloat32Array(1.0, 1.0),
"update": 1,
"values": [true, false]
}

[sub_resource type="AnimationLibrary" id="AnimationLibrary_1"]
_data = {
"blink_warning": SubResource("Animation_blink")
}

; ============================================================
; SCENE TREE: CanvasLayer → root control
; ============================================================

[node name="HUD" type="CanvasLayer"]
layer = 10
script = ExtResource("1_hud_script")

[node name="HUDRoot" type="Control" parent="."]
layout_mode = 3
