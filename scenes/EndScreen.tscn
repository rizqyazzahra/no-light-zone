[gd_scene format=3 uid="uid://endscreen_001"]

[ext_resource type="Script" path="res://scripts/EndScreen.gd" id="1_endscreen_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.04, 0.04, 0.1, 0.96)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.2, 0.2, 0.45, 0.8)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_btn"]
bg_color = Color(0.1, 0.1, 0.22, 0.9)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.3, 0.3, 0.6, 0.8)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_hover"]
bg_color = Color(0.18, 0.18, 0.38, 1.0)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.6, 0.6, 1.0, 1.0)

; ============================================================
; SCENE TREE
; ============================================================

[node name="EndScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_endscreen_script")

; --- Full dark background ---
[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.02, 0.02, 0.06, 1)
mouse_filter = 2

; --- Center card ---
[node name="Card" type="PanelContainer" parent="."]
layout_mode = 1
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -160.0
offset_right = 220.0
offset_bottom = 160.0
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="VBox" type="VBoxContainer" parent="Card"]
layout_mode = 2
theme_override_constants/separation = 18

; --- Title (win/lose, set by script) ---
[node name="TitleLabel" type="Label" parent="Card/VBox"]
layout_mode = 2
text = "..."
horizontal_alignment = 1
theme_override_font_sizes/font_size = 26
theme_override_colors/font_color = Color(1, 1, 1, 1)

; --- Subtitle / reason ---
[node name="SubtitleLabel" type="Label" parent="Card/VBox"]
layout_mode = 2
text = "..."
horizontal_alignment = 1
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.65, 0.65, 0.8, 1)
autowrap_mode = 3

[node name="Divider" type="HSeparator" parent="Card/VBox"]
layout_mode = 2
modulate = Color(0.25, 0.25, 0.5, 0.6)

; --- Buttons ---
[node name="Buttons" type="HBoxContainer" parent="Card/VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 16

[node name="RetryButton" type="Button" parent="Card/VBox/Buttons"]
layout_mode = 2
custom_minimum_size = Vector2(130, 40)
text = "↺ Try Again"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.6, 1.0, 0.6, 1)
theme_override_styles/normal = SubResource("StyleBoxFlat_btn")
theme_override_styles/hover = SubResource("StyleBoxFlat_hover")
theme_override_styles/focus = SubResource("StyleBoxFlat_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_hover")

[node name="MenuButton" type="Button" parent="Card/VBox/Buttons"]
layout_mode = 2
custom_minimum_size = Vector2(130, 40)
text = "⌂ Main Menu"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.7, 0.7, 1.0, 1)
theme_override_styles/normal = SubResource("StyleBoxFlat_btn")
theme_override_styles/hover = SubResource("StyleBoxFlat_hover")
theme_override_styles/focus = SubResource("StyleBoxFlat_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_hover")
