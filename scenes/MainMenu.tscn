; ============================================================
; SCENE TREE
; ============================================================

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_mainmenu_script")

; --- Dark background ---
[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.03, 0.03, 0.07, 1)

; --- Scanline overlay (dark horizontal stripe pattern feel) ---
[node name="VignetteStripe" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.0, 0.0, 0.05, 0.35)
mouse_filter = 2

; --- Center content ---
[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180.0
offset_top = -180.0
offset_right = 180.0
offset_bottom = 180.0
theme_override_constants/separation = 16
alignment = 1

; --- Title ---
[node name="TitleLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "NO LIGHT ZONE"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 36
theme_override_colors/font_color = Color(0.95, 0.95, 1.0, 1)

; --- Tagline ---
[node name="TaglineLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "Find the generator. Survive the dark."
horizontal_alignment = 1
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.45, 0.45, 0.65, 1)

; --- Divider ---
[node name="Divider" type="HSeparator" parent="VBox"]
layout_mode = 2
modulate = Color(0.25, 0.25, 0.5, 0.6)

; --- Spacer ---
[node name="Spacer" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 12)

; --- Play Button ---
[node name="PlayButton" type="Button" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(200, 44)
text = "▶  START GAME"
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.7, 1.0, 0.7, 1)
theme_override_styles/normal = SubResource("StyleBoxFlat_bg_btn")
theme_override_styles/hover = SubResource("StyleBoxFlat_hover_btn")
theme_override_styles/focus = SubResource("StyleBoxFlat_focus_btn")
theme_override_styles/pressed = SubResource("StyleBoxFlat_focus_btn")

; --- Quit Button ---
[node name="QuitButton" type="Button" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(200, 44)
text = "✕  QUIT"
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.8, 0.5, 0.5, 1)
theme_override_styles/normal = SubResource("StyleBoxFlat_bg_btn")
theme_override_styles/hover = SubResource("StyleBoxFlat_hover_btn")
theme_override_styles/focus = SubResource("StyleBoxFlat_focus_btn")
theme_override_styles/pressed = SubResource("StyleBoxFlat_focus_btn")

; --- Controls hint ---
[node name="ControlsLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "WASD: Move   Mouse: Aim   F: Flashlight   E: Interact"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 9
theme_override_colors/font_color = Color(0.28, 0.28, 0.45, 1)

; --- Blink hint ---
[node name="BlinkLabel" type="Label" parent="."]
layout_mode = 1
